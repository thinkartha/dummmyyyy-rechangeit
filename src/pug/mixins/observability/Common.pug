mixin ObsPageHeader(config)
  .mb-6
    .row.align-items-center.g-3
      .col
        h2.mb-2= config.title
        h5.text-body-tertiary.fw-semibold.mb-0= config.subtitle
      if config.linkHref
        //- Connecting a source happens under Integrations, on that source's own page.
        //- A monitoring page links there rather than carrying a second copy of the form:
        //- two entry points to one credential is how they drift apart.
        .col-auto
          a.btn.btn-phoenix-primary(href=config.linkHref)= config.linkText
      else if config.action || config.secondaryAction
        //- Only the two-button pages need the flex row; keeping it conditional means
        //- adding this option did not rewrite the markup of every other page.
        .col-auto(class=config.secondaryAction ? 'd-flex gap-2' : '')
          //- actionKey names an entry in integration/actions.js. Without one the button
          //- stays inert, which is what every page did before the write layer existed.
          //- A page can carry two: the API gateway page offers both "connect the one you
          //- already run" and "install ours", which are different jobs, not one job with
          //- a mode switch.
          if config.secondaryAction
            button.btn.btn-phoenix-secondary(type='button' data-lhb-action=config.secondaryActionKey)= config.secondaryAction
          if config.action
            //- actionRole hides the button unless the session holds that role. The API
            //- 403s either way; this is so the page does not offer what it cannot do.
            button.btn.btn-primary(type='button' data-lhb-action=config.actionKey data-lhb-requires-role=config.actionRole)= config.action

//- The numbers in these cards are illustrative unless the card carries a `key`, which
//- names a figure a live source publishes. `data-obs-stat` is what live-data.js blanks
//- when mock data is off, so a page never shows a fabricated total beside a table that
//- correctly says it has no data; `data-obs-stat-key` is what it then fills back in for
//- the cards that do have a measurement behind them.
mixin ObsStatCards(stats)
  .row.g-3.mb-6
    each stat in stats
      .col-12.col-sm-6.col-xl-3
        .card.h-100
          .card-body
            //- gap-2 and min-width:0 are both load-bearing. A delta is not always a
            //- short word: the p99 card's delta is the slowest route's *path*, and a
            //- flex item defaults to min-width:auto, so the badge refused to shrink and
            //- ran outside the card instead. Zero min-width lets both sides give, and
            //- text-truncate is what they do with the space they have.
            .d-flex.justify-content-between.align-items-start.gap-2
              div(style='min-width:0')
                h6.text-body-tertiary.mb-2.text-truncate(title=stat.label)= stat.label
                h3.mb-0.text-truncate(data-obs-stat data-obs-stat-key=stat.key title=stat.value)= stat.value
              //- text-transform:none because the theme uppercases badges, and these
              //- carry route paths — which are case-sensitive, so shouting them is
              //- not just ugly, it shows something the server never said.
              //- The title keeps the full value reachable once it is truncated.
              span.badge.badge-phoenix.text-truncate(
                class=`badge-phoenix-${stat.badge || 'primary'}`
                style='max-width:55%;text-transform:none'
                title=stat.delta
                data-obs-stat-delta
                data-obs-stat-delta-key=stat.key)= stat.delta

//- A KPI strip in the shape monitoring products use: a small uppercase label with an
//- info affordance, one large number, and a delta chip beside it. Distinct from
//- ObsStatCards, which is the wider four-up card used on the list pages — this one packs
//- six figures into one row and scrolls sideways rather than wrapping to a second row,
//- because a KPI strip that reflows moves the number somebody was looking at.
//-
//- Same data contract as ObsStatCards: `key` names a figure a live source publishes,
//- `data-obs-stat` is what live-data blanks before the first measurement lands.
mixin ObsKpiRow(stats)
  .obs-kpi-row.d-flex.gap-3.mb-4.pb-1(style='overflow-x:auto;scrollbar-width:thin')
    each stat in stats
      .card.flex-shrink-0(style='min-width:11.5rem;flex:1 1 0')
        .card-body.py-3.px-3
          .d-flex.align-items-center.gap-1.mb-2
            h6.text-body-tertiary.text-uppercase.fs-10.fw-semibold.mb-0.lh-1(style='letter-spacing:.04em')= stat.label
            //- The help text is the tooltip, not a second line of body copy: these tiles
            //- are read at a glance and a sentence under each one defeats that.
            if stat.help
              span.text-body-quaternary.fs-10(data-bs-toggle='tooltip' data-bs-placement='top' title=stat.help)
                span.fa-solid.fa-circle-info
          .d-flex.align-items-baseline.gap-2(style='min-width:0')
            //- Proportional figures, not tabular: at this size equal-width digits make a
            //- number like 121 look loose. Tabular is for columns that must align.
            h2.mb-0.fw-semibold.lh-1(data-obs-stat data-obs-stat-key=stat.key)= stat.value
            //- Same truncation rules as ObsStatCards — see the note there.
            span.badge.badge-phoenix.fs-10.text-truncate(
              class=`badge-phoenix-${stat.badge || 'secondary'}`
              style='max-width:60%;text-transform:none'
              title=stat.delta
              data-obs-stat-delta
              data-obs-stat-delta-key=stat.key)= stat.delta

//- A chart in a card, with the header treatment the KPI row uses so the two read as one
//- system. `chart` names an entry in integration/charts.js.
mixin ObsChartCard(config)
  .card.h-100
    .card-header.border-bottom.border-translucent.py-3
      .d-flex.align-items-center.justify-content-between.gap-2
        .d-flex.align-items-center.gap-1
          h6.text-body-tertiary.text-uppercase.fs-10.fw-semibold.mb-0.lh-1(style='letter-spacing:.04em')= config.title
          if config.help
            span.text-body-quaternary.fs-10(data-bs-toggle='tooltip' data-bs-placement='top' title=config.help)
              span.fa-solid.fa-circle-info
        if config.action
          button.btn.btn-link.btn-sm.p-0.text-body-tertiary(type='button' data-lhb-action=config.actionKey title=config.action)
            span.fa-solid.fa-arrows-rotate
    .card-body
      //- The height is on the element because echarts measures its container: a chart in
      //- a box with no height initialises at zero and draws nothing. Axis labels sit
      //- inside this box (grid containLabel), so none of them are clipped by it.
      div(data-lhb-chart=config.chart style=`height:${config.height || '300px'};width:100%`)

//- Tabs over one page's worth of content. Bootstrap's tab JS is already loaded by the
//- layout; nothing here needs its own script.
//-
//- Charts must live in the tab that is active on load — echarts sizes itself against its
//- container, and a container inside a hidden pane measures zero. charts.js listens for
//- Bootstrap's shown.bs.tab and resizes, which covers the way back.
mixin ObsTabs(tabs)
  ul.nav.nav-underline.mb-4(role='tablist')
    each tab, i in tabs
      li.nav-item(role='presentation')
        button.nav-link.d-flex.align-items-center.gap-2(
          class=(i === 0 ? 'active' : '')
          id=`${tab.id}-tab`
          data-bs-toggle='tab'
          data-bs-target=`#${tab.id}`
          type='button'
          role='tab'
          aria-controls=tab.id
          aria-selected=(i === 0 ? 'true' : 'false'))
          if tab.icon
            span(class=`fa-solid ${tab.icon} fs-10`)
          = tab.label

mixin ObsToolTable(config)
  -
    var pageSize = config.pageSize || 5;
    var columns = config.columns || [];
    var valueNames = columns.map(function (col, i) {
      return col.key || ('col' + i);
    });
    var filterKey = (config.filter && config.filter.key) || valueNames[valueNames.length - 1] || 'status';
    var filterLabel = (config.filter && config.filter.label) || 'Filter';
    var filterOptions = (config.filter && config.filter.options) || [];
    if (!filterOptions.length) {
      var seen = {};
      (config.rows || []).forEach(function (row) {
        var last = row.cells[row.cells.length - 1];
        var text = last && last.badge ? last.text : (typeof last === 'string' ? last : null);
        if (text && !seen[text]) {
          seen[text] = true;
          filterOptions.push(text);
        }
      });
    }
    var listOptions = {
      valueNames: valueNames,
      page: pageSize,
      filter: { key: filterKey }
    };

  //- config.live names an entry in integration/live-data.js. The static rows below
  //- stay in the markup as the fallback: if the API is unreachable or the visitor is
  //- signed out, the page still renders and the card header says which it is.
  div.obs-list-root(data-list!=listOptions data-live-table=config.live)
    .card
      .card-header.border-bottom.border-translucent.py-3
        .row.align-items-center.g-2.mb-3
          .col
            h4.mb-0= config.title
            p.text-body-tertiary.fs-9.mb-0= config.subtitle
          //- A table that lives in a tab cannot use the page header's button — the page
          //- header belongs to whichever tab is not open. Its own create button does.
          if config.action
            .col-auto
              button.btn.btn-primary.btn-sm(type='button' data-lhb-action=config.actionKey)= config.action
        .row.align-items-center.g-2
          .col-12.col-md
            +Search({placeholder: config.searchPlaceholder || 'Search', inputClass: 'form-control-sm'}).w-100
          .col-6.col-md-auto
            select.form-select.form-select-sm(data-list-filter aria-label=filterLabel)
              option(value='')= filterLabel + ': All'
              each opt in filterOptions
                option(value=opt)= opt
          .col-6.col-md-auto
            select.form-select.form-select-sm(aria-label='Sort by' data-obs-sort)
              option(value='') Sort by
              each col, idx in columns
                option(value=valueNames[idx])= col.label
      .card-body.p-0
        .table-responsive.scrollbar
          table.table.table-sm.fs-9.mb-0
            thead
              tr
                each col, idx in columns
                  th.sort.align-middle.white-space-nowrap.text-uppercase(
                    class=col.className || ''
                    scope='col'
                    data-sort=valueNames[idx]
                  )= col.label
                if config.rowAction
                  th.align-middle.text-end.pe-3(scope='col')
            //- `data-sample-rows` is what the pre-paint CSS hides when mock data is off.
            //- live-data.js drops the attribute the moment it puts real rows (or the
            //- empty state) here, which is what makes them visible.
            tbody.list(data-sample-rows)
              each row in config.rows
                tr
                  each cell, idx in row.cells
                    - var colKey = valueNames[idx]
                    if idx === 0
                      td.align-middle.ps-3.py-3(class=colKey)
                        .d-flex.align-items-center
                          span.me-2(class=`${row.iconSet || 'fa-solid'} ${row.icon || 'fa-cube'} text-${row.iconColor || 'primary'}`)
                          div
                            h6.mb-0= typeof cell === 'object' && cell.text ? cell.text : cell
                            if row.meta
                              p.text-body-tertiary.fs-10.mb-0= row.meta
                    else if cell && cell.badge
                      td.align-middle(class=colKey)
                        span.badge.badge-phoenix(class=`badge-phoenix-${cell.badge}`)= cell.text
                    else
                      td.align-middle(class=colKey)= cell
                  if row.action
                    td.align-middle.text-end.pe-3
                      button.btn.btn-phoenix-secondary.btn-sm(
                        type='button'
                        data-lhb-action=row.action.key
                        data-lhb-arg=row.action.arg
                      )= row.action.label
                  else if config.rowAction
                    //- Sample rows get an empty cell, not a button: the id behind a
                    //- placeholder row does not exist, and a Brief that 404s is worse
                    //- than no Brief. Live rows carry their own action.
                    td.align-middle.pe-3
        .text-center.p-3.fallback.d-none
          p.mb-0.text-body-tertiary No matching results
      .card-footer.border-top.border-translucent
        .row.align-items-center.g-2
          .pagination.d-none
          .col.d-flex.fs-9.flex-wrap
            p.mb-0.d-none.d-sm-block.me-3.fw-semibold.text-body(data-list-info)
            a.fw-semibold(href='#!' data-list-view='*')
              | View all
              span.fas.fa-angle-right.ms-1(data-fa-transform='down-1')
            a.fw-semibold.d-none(href='#!' data-list-view='less')
              | View less
          .col-auto.d-flex
            button.btn.btn-link.px-1.me-1(type='button' title='Previous' data-list-pagination='prev')
              span.fas.fa-chevron-left.me-2
              | Previous
            button.btn.btn-link.px-1.ms-1(type='button' title='Next' data-list-pagination='next')
              | Next
              span.fas.fa-chevron-right.ms-2
  script.
    (function () {
      document.querySelectorAll('[data-obs-sort]').forEach(function (select) {
        if (select.dataset.bound === '1') return;
        select.dataset.bound = '1';
        select.addEventListener('change', function () {
          var key = select.value;
          if (!key) return;
          var root = select.closest('[data-list]');
          if (!root) return;
          var header = root.querySelector('th[data-sort="' + key + '"]');
          if (header) header.click();
        });
      });
    })();
