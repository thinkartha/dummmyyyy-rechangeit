  -
    /* The authentication screens are not product navigation — they are where you are
       before there is any — so they stay out of `sitemap` and out of the sidebar. They
       still need names: every "Create an account" and "Forgot password?" link resolves
       through `paths`, and without these entries each one compiled to `undefined`. */
    var publicPaths = {
      'landing-home': 'index.html'
    };
    var authPaths = {
      //- The product's own auth screens. The simple/card/split trio below them is theme
      //- demonstration and is not what the app links to.
      'product-signin': 'pages/authentication/sign-in.html',
      'product-signup': 'pages/authentication/sign-up.html',
