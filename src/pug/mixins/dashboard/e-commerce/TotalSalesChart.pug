mixin TotalSalesChart
  .row.flex-between-center.mb-4.g-3
    .col-auto
      h3 Platform spend & traffic
      p.text-body-tertiary.lh-sm.mb-0 Cloud cost + AI cost + API volume across the org
    .col-8.col-sm-4
      select.form-select.form-select-sm#select-gross-revenue-month
        option Mar 1 - 31, 2026
        option April 1 - 30, 2026
        option May 1 - 31, 2026
  .echart-total-sales-chart(style='min-height:320px;width:100%')
