          th.sort.text-end.pe-0.align-middle(scope='col')
      tbody.list#table-latest-review-body
        each row,index in latestReviewsTableData
          +LatestReviewsTableRow(row,index)

mixin LatestReviews
  div(data-list!={
    valueNames: ["product", "customer", "rating", "review", "time"],
    page: 6,
  })
    .row.align-items-end.justify-content-between.pb-5.g-3
      .col-auto
        h3 Active alerts
        p.text-body-tertiary.lh-sm.mb-0 API · AI Gateway · ETL · Cloud · Cost anomalies
      .col-12.col-md-auto
        .row.g-2.gy-3
          .col-auto.flex-1
            +Search({placeholder:'Search alerts', inputClass: 'form-control-sm'})
          .col-auto
            button.btn.btn-sm.btn-phoenix-secondary.bg-body-emphasis.bg-body-hover.me-2(type='button') All sources
            button.btn.btn-sm.btn-phoenix-secondary.bg-body-emphasis.bg-body-hover.action-btn(type='button' data-bs-toggle='dropdown' data-boundary="window" aria-haspopup="true" aria-expanded="false" data-bs-reference="parent" )
              span.fas.fa-ellipsis-h(data-fa-transform="shrink-2")
            ul.dropdown-menu.dropdown-menu-end
              li
                a.dropdown-item(href='#') Acknowledge all
              li
                a.dropdown-item(href='#') Mute noise
              li
                a.dropdown-item(href='#') Export

    +LatestReviewsTable
    .row.align-items-center.py-1
      .pagination.d-none
      .col.d-flex.fs-9
        p.mb-0.d-none.d-sm-block.me-3.fw-semibold.text-body(data-list-info)
        a.fw-semibold(href='#!' data-list-view="*")
          | View all
          span.fas.fa-angle-right.ms-1(data-fa-transform='down-1')
        a.fw-semibold.d-none(href='#!' data-list-view="less")
          | View Less
      .col-auto.d-flex
        = '\n'
        button(type='button' title="Previous" data-list-pagination='prev').btn.btn-link.px-1.me-1
          span.fas.fa-chevron-left.me-2
          | Previous
        button(type='button' title="Next" data-list-pagination='next').btn.btn-link.px-1.ms-1
          | Next
          span.fas.fa-chevron-right.ms-2
