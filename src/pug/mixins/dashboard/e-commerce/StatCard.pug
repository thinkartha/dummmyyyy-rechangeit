mixin TotalOrders
  .card.h-100
    .card-body
      .d-flex.justify-content-between
        div
          h5.mb-1 API requests
            span.badge.badge-phoenix.badge-phoenix-success.rounded-pill.fs-9.ms-2
              span.badge-label +12.4%
          h6.text-body-tertiary Last 7 days
        h4 2.4M
      .d-flex.justify-content-center.px-4.py-6
        .echart-total-orders(style='height:85px;width:115px')
      .mt-2
        .d-flex.align-items-center.mb-2
          .bullet-item.bg-primary.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Success (2xx)
          h6.text-body.fw-semibold.mb-0 97.2%
        .d-flex.align-items-center
          .bullet-item.bg-primary-subtle.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Errors (4xx/5xx)
          h6.text-body.fw-semibold.mb-0 2.8%

mixin NewCustomers
  .card.h-100
    .card-body
      .d-flex.justify-content-between
        div
          h5.mb-1 AI tool usage
            span.badge.badge-phoenix.badge-phoenix-warning.rounded-pill.fs-9.ms-2 
              span.badge-label +26.5%
          h6.text-body-tertiary Tokens · last 7 days
        h4 48.2M
      .pb-0.pt-4
        .echarts-new-customers(style='height:180px;width:100%;')

mixin TopCoupons
  .card.h-100
    .card-body
      .d-flex.justify-content-between
        div
          h5.mb-2 AI spend mix
          h6.text-body-tertiary ChatGPT · Claude · Cursor · Copilot
      .pb-4.pt-3
        .echart-top-coupons(style='height:115px;width:100%;')
      div
        .d-flex.align-items-center.mb-2
          .bullet-item.bg-primary.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 ChatGPT / OpenAI
          h6.text-body.fw-semibold.mb-0 34%
        .d-flex.align-items-center.mb-2
          .bullet-item.bg-primary-lighter.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Claude / Anthropic
          h6.text-body.fw-semibold.mb-0 22%
        .d-flex.align-items-center
          .bullet-item.bg-info-dark.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Cursor · Copilot · Grok · others
          h6.text-body.fw-semibold.mb-0 44%

mixin PayingCustomer
  .card.h-100
    .card-body.d-flex.flex-column
      .d-flex.justify-content-between
        div
          h5.mb-2 ETL pipeline health
          h6.text-body-tertiary Last 7 days
      .d-flex.justify-content-center.pt-3.flex-1
        .echarts-paying-customer-chart(style='height:100%;width:100%;')
      .mt-3
        .d-flex.align-items-center.mb-2
          .bullet-item.bg-primary.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Healthy runs
          h6.text-body.fw-semibold.mb-0 88%
        .d-flex.align-items-center
          .bullet-item.bg-primary-subtle.me-2
          h6.text-body.fw-semibold.flex-1.mb-0 Failed / delayed
          h6.text-body.fw-semibold.mb-0 12%
