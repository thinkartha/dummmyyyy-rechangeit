extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

//- One page for every account, selected by ?account=<id>. The build is a static export,
//- so a route per account is not available and would be wrong anyway — the account list
//- is AWS's, discovered at read time, and nothing here is registered in advance.
append variables
  -
    var useECharts = true;
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Cloud Monitoring', href: `${CWD}${paths['obs-cloud-monitoring']}` },
      { label: 'Account', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Account detail',
    subtitle: 'Everything this AWS account is reporting — alarms, streamed metrics, spend and changes',
    linkHref: `${CWD}${paths['obs-cloud-monitoring']}`,
    linkText: 'All accounts'
  })

  //- Filled by live-data from the account row, so the page says which account it is
  //- rather than making the reader read the query string.
  .mb-4(data-account-heading)
    h3.mb-1(data-account-name) —
    p.text-body-tertiary.fs-9.mb-0(data-account-meta) Loading account…

  +ObsStatCards([
    { key: 'accountAlarms', label: 'Open alarms', value: '—', delta: 'no data', badge: 'danger' },
    { key: 'accountResources', label: 'Resources', value: '—', delta: 'no data', badge: 'info' },
    { key: 'accountServices', label: 'Streamed services', value: '—', delta: 'no data', badge: 'success' },
    { key: 'accountSpend', label: 'Spend month to date', value: '—', delta: 'no data', badge: 'primary' }
  ])

  //- One filter row above everything it scopes, rather than a picker tucked inside each
  //- card. Range first — it is the control every reader reaches for.
  //-
  //- The range scopes the windowed things below it: the metric chart and the streamed-
  //- resources table. Alarms are current state and spend is month-to-date by
  //- definition, so neither can honour a range; the row says which is which rather than
  //- leaving a control that appears to govern them and silently does not.
  .card.mb-4
    .card-body.py-3
      .row.g-3.align-items-end
        .col-6.col-sm-3.col-lg-2
          label.form-label.fs-9.mb-1(for='account-range') Range
          select#account-range.form-select.form-select-sm(data-lhb-chart-control data-lhb-refresh aria-label='Time range')
            option(value='3') Last 3h
            option(value='12') Last 12h
            option(value='24') Last 24h
            option(value='168') Last 7d
        .col-12.col-sm-6.col-lg-4
          label.form-label.fs-9.mb-1(for='account-metric') Metric
          select#account-metric.form-select.form-select-sm(data-lhb-chart-control aria-label='Metric to chart')
        .col.text-sm-end
          span.text-body-tertiary.fs-10 Range scopes the metric chart and streamed resources. Alarms are current state; spend is month to date.

  .row.g-4.mb-4
    .col-12.col-xl-7
      .card.h-100
        .card-header.border-bottom.border-translucent.py-3
          h4.mb-0 Metric over time
          p.text-body-tertiary.fs-9.mb-0 One line per resource, the five highest by peak. Anything beyond folds into “Other” rather than being dropped.
        .card-body
          //- The height is on the element because echarts measures its container: a
          //- chart in a box with no height initialises at zero and draws nothing. The
          //- axis labels live inside this box (grid containLabel), so nothing is clipped.
          div(data-lhb-chart='accountMetric' style='height:320px;width:100%')
    .col-12.col-xl-5
      .card.h-100
        .card-header.border-bottom.border-translucent.py-3
          h4.mb-0 Spend by service
          p.text-body-tertiary.fs-9.mb-0 Month to date for this account, largest first. Every bar is labelled with its value.
        .card-body
          div(data-lhb-chart='accountSpend' style='height:320px;width:100%')

  +ObsToolTable({
    title: 'Open alarms',
    live: 'accountAlarms',
    subtitle: 'CloudWatch alarms currently in ALARM, across every region this connector reads',
    searchPlaceholder: 'Search alarms',
    pageSize: 5,
    columns: [
      { label: 'Alarm', className: 'ps-3' },
      { label: 'Metric' },
      { label: 'Region' },
      { label: 'Since' },
      { label: 'State' }
    ],
    rows: [
      { icon: 'fa-bell', iconColor: 'danger', meta: 'threshold crossed', cells: ['cpu-high-prod', 'CPUUtilization', 'us-east-1', '2026-09-10T09:40:00Z', { text: 'In alarm', badge: 'danger' }] }
    ]
  })

  +ObsToolTable({
    title: 'Streamed resources',
    live: 'accountResources',
    subtitle: 'Every resource this account’s metric stream has described',
    searchPlaceholder: 'Search resources',
    pageSize: 10,
    columns: [
      { label: 'Resource', className: 'ps-3' },
      { label: 'Service' },
      { label: 'Region' },
      { label: 'Metrics' },
      { label: 'Last seen' },
      { label: 'Freshness' }
    ],
    rows: [
      { icon: 'fa-cube', iconColor: 'info', meta: 'InstanceId=i-0abc123', cells: ['i-0abc123', 'EC2', 'us-east-1', '14', '2026-09-10T10:04:00Z', { text: 'Live', badge: 'success' }] }
    ]
  })

  +ObsToolTable({
    title: 'Recent changes',
    live: 'accountChanges',
    subtitle: 'What appeared, vanished or changed in this account between inventory snapshots',
    searchPlaceholder: 'Search changes',
    pageSize: 5,
    columns: [
      { label: 'Resource', className: 'ps-3' },
      { label: 'Kind' },
      { label: 'Seen' },
      { label: 'Change' }
    ],
    rows: [
      { icon: 'fa-plus', iconColor: 'success', meta: 'assets-staging', cells: ['assets-staging', 'S3 bucket', '2026-09-10T08:00:00Z', { text: 'Added', badge: 'success' }] }
    ]
  })
