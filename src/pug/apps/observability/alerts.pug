extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Alerts', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Alerts Monitoring',
    subtitle: 'Unified alerts from APIs, AI tools, ETL jobs, and multi-cloud accounts',
    action: 'Create alert rule',
    actionKey: 'createAlertRule'
  })

  +ObsStatCards([
    { label: 'Open alerts', value: '27', delta: '12 critical', badge: 'danger' },
    { label: 'Acknowledged', value: '9', delta: 'today', badge: 'info' },
    { label: 'Resolved (24h)', value: '41', delta: '+6', badge: 'success' },
    { label: 'MTTR', value: '34m', delta: '-8m', badge: 'success' }
  ])

  +ObsToolTable({
    title: 'Active alerts',
    live: 'alerts',
    subtitle: 'Cross-domain signal stream',
    searchPlaceholder: 'Search alerts',
    columns: [
      { label: 'Alert', className: 'ps-3' },
      { label: 'Source' },
      { label: 'Severity' },
      { label: 'Owner' },
      { label: 'Age' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-triangle-exclamation', iconColor: 'danger', meta: '/v1/checkout', cells: ['p99 latency spike', 'API Monitoring', { text: 'Critical', badge: 'danger' }, 'Platform SRE', '12m', { text: 'Open', badge: 'warning' }] },
      { icon: 'fa-robot', iconColor: 'warning', meta: 'openai org', cells: ['ChatGPT spend threshold', 'AI Monitoring', { text: 'Warning', badge: 'warning' }, 'FinOps', '28m', { text: 'Open', badge: 'warning' }] },
      { icon: 'fa-shuffle', iconColor: 'info', meta: 'apigee-x', cells: ['Apigee rate-limit storm', 'AI Gateway', { text: 'Warning', badge: 'warning' }, 'API Platform', '41m', { text: 'Ack', badge: 'info' }] },
      { icon: 'fa-diagram-project', iconColor: 'danger', meta: 'customer_sync', cells: ['Glue job failed', 'ETL Monitoring', { text: 'Critical', badge: 'danger' }, 'Data Eng', '1h', { text: 'Open', badge: 'warning' }] },
      { icon: 'fa-cloud', iconColor: 'warning', meta: 'aws-prod-042', cells: ['EC2 cost anomaly', 'Cloud Cost', { text: 'Warning', badge: 'warning' }, 'Cloud Ops', '2h', { text: 'Open', badge: 'warning' }] }
    ]
  })

  //- Clustering, on the page where alerts are read. `clusters` collapses near-identical
  //- alerts by message template; the row action opens the brief and, for agent
  //- incidents, hands it to the coding agent that has to fix them.
  +ObsToolTable({
    title: 'Alert clusters',
    live: 'clusters',
    subtitle: 'Near-identical alerts collapsed by message template — open a brief to hand one to a coding agent',
    searchPlaceholder: 'Search clusters',
    pageSize: 5,
    columns: [
      { label: 'Cluster', className: 'ps-3' },
      { label: 'Severity' },
      { label: 'Alerts' },
      { label: 'Services' },
      { label: 'Last seen' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-layer-group', iconColor: 'danger', meta: 'cluster-checkout-timeout', cells: ['Upstream timeout on <route>', { text: 'Critical', badge: 'danger' }, '38', 'checkout-api, payments', '3m ago', { text: 'Firing', badge: 'danger' }] },
      { icon: 'fa-layer-group', iconColor: 'warning', meta: 'cluster-rate-limit', cells: ['Rate limit exceeded for <consumer>', { text: 'Warning', badge: 'warning' }, '17', 'partner-api', '11m ago', { text: 'Firing', badge: 'danger' }] },
      { icon: 'fa-layer-group', iconColor: 'info', meta: 'cluster-glue-retry', cells: ['Job <name> retried', { text: 'Info', badge: 'info' }, '9', 'customer_sync', '46m ago', { text: 'Resolved', badge: 'success' }] }
    ]
  })

  +ObsToolTable({
    title: 'Agent incident clusters',
    live: 'agentIncidentClusters',
    subtitle: 'Failures the AI agents reported, clustered the same way — these can be dispatched to a coding agent, not just copied',
    searchPlaceholder: 'Search agent incidents',
    pageSize: 5,
    columns: [
      { label: 'Cluster', className: 'ps-3' },
      { label: 'Severity' },
      { label: 'Failures' },
      { label: 'Agents' },
      { label: 'Last seen' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-robot', iconColor: 'danger', meta: 'agent-tool-timeout', cells: ['Tool call <tool> timed out', { text: 'Critical', badge: 'danger' }, '24', 'support-copilot', '5m ago', { text: 'Firing', badge: 'danger' }] },
      { icon: 'fa-robot', iconColor: 'warning', meta: 'agent-context-overflow', cells: ['Context window exceeded on <model>', { text: 'Warning', badge: 'warning' }, '12', 'research-agent', '22m ago', { text: 'Firing', badge: 'danger' }] },
      { icon: 'fa-robot', iconColor: 'info', meta: 'agent-eval-regression', cells: ['Evaluation <name> below threshold', { text: 'Info', badge: 'info' }, '6', 'summarizer', '1h ago', { text: 'Resolved', badge: 'success' }] }
    ]
  })
