extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Cloud Cost', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Cloud Cost Monitoring',
    subtitle: 'Multi-account spend, budgets, and anomalies across AWS, GCP, and Azure',
    action: 'Add budget',
    actionKey: 'addBudget'
  })

  //- The first three are measured: the `cloudCost` source publishes them by key from the
  //- same Cost Explorer response that fills the table below. "Savings opportunities" has
  //- no key because nothing computes it for a real tenant — rightsizing needs per-tenant
  //- utilization that is not collected — so it stays blank rather than quoting a figure.
  +ObsStatCards([
    { label: 'MTD cloud spend', key: 'mtdSpend', value: '—', delta: 'no data', badge: 'warning' },
    { label: 'Forecast EOM', key: 'forecastEom', value: '—', delta: 'no data', badge: 'danger' },
    { label: 'Accounts over budget', key: 'accountsOverBudget', value: '—', delta: 'no data', badge: 'warning' },
    { label: 'Savings opportunities', value: '—', delta: 'no data', badge: 'success' }
  ])

  //- Month-to-date spend from AWS Cost Explorer for the account connected under
  //- Integrations → Cloud accounts, joined against the budgets stored for this tenant.
  //- A payer account lists every member account it settles for; a standalone account is
  //- one row. GCP and Azure have no cost connector yet, so neither appears.
  +ObsToolTable({
    title: 'Spend by account',
    live: 'cloudCost',
    subtitle: 'Month-to-date AWS spend from Cost Explorer, against the budgets you have set',
    searchPlaceholder: 'Search accounts',
    columns: [
      { label: 'Account', className: 'ps-3' },
      { label: 'Cloud' },
      { label: 'MTD' },
      { label: 'Budget' },
      { label: 'Variance' },
      { label: 'Status' }
    ],
    rows: []
  })

  //- Spend grouped by something other than the account paying for it. The table above
  //- answers "which account", which cannot answer "which service" or "which team" — a
  //- tag grouping is the only way to get the second. The tag options here are the two
  //- conventional keys; any tag key works through the API, and this list is where to
  //- add one a customer actually uses.
  .card.mb-4
    .card-header.border-bottom.border-translucent.py-3
      .row.align-items-center.g-2
        .col
          h4.mb-0 Spend breakdown
          p.text-body-tertiary.fs-9.mb-0 Month to date, grouped. Untagged spend is shown rather than dropped — it is usually why you opened this.
        .col-auto
          label.form-label.fs-9.mb-1(for='cost-group-by') Group by
          select#cost-group-by.form-select.form-select-sm(data-lhb-refresh)
            option(value='SERVICE') Service
            option(value='REGION') Region
            option(value='USAGE_TYPE') Usage type
            option(value='team') Tag: team
            option(value='environment') Tag: environment
    .card-body.pt-0
      +ObsToolTable({
        live: 'costBreakdown',
        title: 'By group',
        subtitle: 'One Cost Explorer request per grouping, cached six hours — the source updates daily',
        searchPlaceholder: 'Search groups',
        pageSize: 8,
        columns: [
          { label: 'Group', className: 'ps-3' },
          { label: 'Spend (MTD)' },
          { label: 'Share' },
          { label: 'Weight' }
        ],
        rows: [
          { icon: 'fa-tag', iconColor: 'info', cells: ['Amazon Elastic Compute Cloud', 'USD 18,220.14', '46.8%', { text: 'Major', badge: 'danger' }] },
          { icon: 'fa-tag', iconColor: 'info', cells: ['Amazon Relational Database Service', 'USD 9,140.02', '23.5%', { text: 'Notable', badge: 'warning' }] },
          { icon: 'fa-tag', iconColor: 'info', cells: ['untagged', 'USD 1,004.55', '2.6%', { text: 'Minor', badge: 'info' }] }
        ]
      })

  //- Rightsizing recommendations from /api/v1/finops/recommendations. Kept separate
  //- from spend-by-account above: that table answers "where did the money go", this
  //- one answers "what would you change", and they have different shapes.
  +ObsToolTable({
    live: 'finops',
    title: 'Rightsizing recommendations',
    subtitle: 'Generated from observed utilization — estimated monthly saving per change',
    searchPlaceholder: 'Search recommendations or components',
    pageSize: 6,
    columns: [
      { label: 'Recommendation', className: 'ps-3' },
      { label: 'Component' },
      { label: 'Namespace' },
      { label: 'Est. saving' },
      { label: 'Confidence' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-coins', iconColor: 'warning', meta: 'resize', cells: ['Reduce CPU request 2.00 → 0.75 cores', 'payments-api', 'prod', '$38.25/mo', '80%', { text: 'High confidence', badge: 'success' }] },
      { icon: 'fa-coins', iconColor: 'warning', meta: 'resize', cells: ['Reduce memory request 4Gi → 1.5Gi', 'checkout-api', 'prod', '$26.40/mo', '76%', { text: 'Review', badge: 'secondary' }] },
      { icon: 'fa-coins', iconColor: 'info', meta: 'idle', cells: ['Scale idle deployment to zero overnight', 'batch-worker', 'stage', '$61.10/mo', '91%', { text: 'High confidence', badge: 'success' }] }
    ]
  })
