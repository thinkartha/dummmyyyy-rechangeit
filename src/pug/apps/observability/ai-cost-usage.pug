extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'AI Cost & Usage', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'AI Cost & Usage',
    subtitle: 'Token usage and billing for ChatGPT, Claude, Cursor, Copilot, Grok, Lovable, and more',
    action: 'Set AI budget',
    actionKey: 'setAiBudget'
  })

  +ObsStatCards([
    { label: 'MTD AI spend', value: '$12.8k', delta: '+18%', badge: 'warning' },
    { label: 'Tokens MTD', value: '162M', delta: '+22%', badge: 'info' },
    { label: 'Top tool', value: 'ChatGPT', delta: '34%', badge: 'primary' },
    { label: 'Budget remaining', value: '$2.2k', delta: 'of $15k', badge: 'success' }
  ])

  +ObsToolTable({
    title: 'Cost by AI tool',
    live: 'aiCost',
    subtitle: 'Organization-wide AI FinOps',
    searchPlaceholder: 'Search tools',
    columns: [
      { label: 'Tool', className: 'ps-3' },
      { label: 'Vendor' },
      { label: 'Tokens MTD' },
      { label: 'Spend MTD' },
      { label: 'Budget' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-comments', iconColor: 'success', meta: 'openai', cells: ['ChatGPT', 'OpenAI', '48M', '$4.1k', '$4.5k', { text: 'On track', badge: 'success' }] },
      { icon: 'fa-robot', iconColor: 'success', meta: 'anthropic', cells: ['Claude', 'Anthropic', '31M', '$2.9k', '$3.0k', { text: 'Watch', badge: 'info' }] },
      { icon: 'fa-code', iconColor: 'primary', meta: 'cursor', cells: ['Cursor', 'Cursor', '29M', '$2.6k', '$2.5k', { text: 'Over', badge: 'danger' }] },
      { iconSet: 'fa-brands', icon: 'fa-github', iconColor: 'secondary', meta: 'copilot', cells: ['GitHub Copilot', 'GitHub', '18M', '$1.1k', '$1.2k', { text: 'On track', badge: 'success' }] },
      { icon: 'fa-bolt', iconColor: 'warning', meta: 'grok', cells: ['Grok', 'xAI', '12M', '$0.9k', '$1.0k', { text: 'On track', badge: 'success' }] },
      { icon: 'fa-wand-magic-sparkles', iconColor: 'info', meta: 'lovable', cells: ['Lovable', 'Lovable', '7M', '$0.5k', '$0.6k', { text: 'On track', badge: 'success' }] },
      { icon: 'fa-seedling', iconColor: 'success', meta: 'babylovegrowth', cells: ['BabyLoveGrowth', 'BabyLoveGrowth', '4M', '$0.3k', '$0.4k', { text: 'On track', badge: 'success' }] },
      { icon: 'fa-microchip', iconColor: 'info', meta: 'deepseek', cells: ['DeepSeek', 'DeepSeek', '8M', '$0.2k', '$0.3k', { text: 'On track', badge: 'success' }] }
    ]
  })
