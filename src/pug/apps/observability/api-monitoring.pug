extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'API Monitoring', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'API Monitoring',
    subtitle: 'Latency, errors, and throughput for the APIs behind your gateways — register them under API Gateway and their traffic shows up here',
    action: 'Refresh',
    actionKey: 'refreshData'
  })

  //- Keys match the stats the apiRoutes source publishes; without one a card can only
  //- ever show "—", which is what all four did. Two labels changed to what the numbers
  //- underneath them actually are: /observability/routes has no time window (it rolls
  //- up every stored span, out to the 30-day record retention), so "Requests (24h)" was
  //- a promise nothing measured, and it knows nothing about gateway registrations.
  +ObsStatCards([
    { label: 'Requests', key: 'requests', value: '—', delta: 'no data', badge: 'info' },
    { label: 'Error rate', key: 'errorRate', value: '—', delta: 'no data', badge: 'success' },
    { label: 'Slowest route p99', key: 'p99Latency', value: '—', delta: 'no data', badge: 'warning' },
    { label: 'Routes', key: 'routes', value: '—', delta: 'no data', badge: 'info' }
  ])

  //- Columns follow what /observability/routes actually returns — route, requests, 5xx,
  //- error rate and the status-code breakdown. The previous set promised Provider, Env
  //- and p99, which that endpoint has never carried: three of six columns rendered "—"
  //- on live data and only looked populated because of the sample rows below.
  +ObsToolTable({
    title: 'Route traffic',
    live: 'apiRoutes',
    subtitle: 'Per-route request counts derived from stored spans — enrolled gateways report their traffic here, as do agent telemetry batches',
    searchPlaceholder: 'Search routes',
    columns: [
      { label: 'Route', className: 'ps-3' },
      { label: 'Requests' },
      { label: '5xx' },
      { label: 'Error rate' },
      { label: 'Status codes' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-route', iconColor: 'success', meta: '200×18270 422×78 503×72', cells: ['POST /api/v1/observability/agents/telemetry', '18,420', '72', '0.39%', '200, 422, 503', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-route', iconColor: 'success', meta: '200×23843 502×47', cells: ['GET /api/v1/observability/agents', '23,890', '47', '0.20%', '200, 502', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-route', iconColor: 'success', meta: '200×11212 500×18', cells: ['GET /api/v1/traces/search', '11,230', '18', '0.16%', '200, 500', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-route', iconColor: 'warning', meta: '200×4120 503×96', cells: ['POST /api/v1/ingest/events', '4,216', '96', '2.28%', '200, 503', { text: 'Degraded', badge: 'warning' }] },
      { icon: 'fa-route', iconColor: 'danger', meta: '200×512 500×61', cells: ['GET /api/v1/finops/recommendations', '573', '61', '10.65%', '200, 500', { text: 'Down', badge: 'danger' }] }
    ]
  })
