extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'AI Monitoring', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'AI Monitoring',
    subtitle: 'Usage, latency, failures, and spend across AI developer tools and models',
    action: 'Connect AI tool',
    actionKey: 'connectAiTool'
  })

  +ObsStatCards([
    { label: 'Tokens (7d)', value: '48.2M', delta: '+26%', badge: 'warning' },
    { label: 'AI spend (7d)', value: '$4,280', delta: '+18%', badge: 'warning' },
    { label: 'Active tools', value: '11', delta: 'org-wide', badge: 'info' },
    { label: 'Failed calls', value: '1.2%', delta: '-0.3%', badge: 'success' }
  ])

  +ObsToolTable({
    title: 'AI tools & providers',
    live: 'aiAgents',
    subtitle: 'Claude · Cursor · Lovable · Grok · ChatGPT · BabyLoveGrowth · DeepSeek · GitHub Copilot and more',
    searchPlaceholder: 'Search AI tools',
    columns: [
      { label: 'Tool', className: 'ps-3' },
      { label: 'Vendor' },
      { label: 'Users' },
      { label: 'Tokens / 7d' },
      { label: 'Spend' },
      { label: 'Status' }
    ],
    rows: [
      { icon: 'fa-robot', iconColor: 'success', meta: 'anthropic', cells: ['Claude', 'Anthropic', '86', '9.4M', '$980', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-code', iconColor: 'primary', meta: 'ide-agent', cells: ['Cursor', 'Cursor', '124', '11.2M', '$1,140', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-wand-magic-sparkles', iconColor: 'info', meta: 'app-builder', cells: ['Lovable', 'Lovable', '18', '2.1M', '$260', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-bolt', iconColor: 'warning', meta: 'xai', cells: ['Grok', 'xAI', '42', '3.8M', '$410', { text: 'Watch', badge: 'info' }] },
      { icon: 'fa-comments', iconColor: 'success', meta: 'openai', cells: ['ChatGPT', 'OpenAI', '210', '14.6M', '$1,320', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-seedling', iconColor: 'success', meta: 'growth', cells: ['BabyLoveGrowth', 'BabyLoveGrowth', '9', '1.0M', '$95', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-microchip', iconColor: 'info', meta: 'deepseek', cells: ['DeepSeek', 'DeepSeek', '27', '2.4M', '$120', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-github', iconColor: 'secondary', meta: 'copilot', cells: ['GitHub Copilot', 'GitHub / Microsoft', '156', '6.7M', '$540', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-windows', iconColor: 'info', meta: 'ms-copilot', cells: ['Microsoft Copilot', 'Microsoft', '73', '3.1M', '$290', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-brain', iconColor: 'primary', meta: 'gemini', cells: ['Gemini', 'Google', '35', '2.0M', '$175', { text: 'Healthy', badge: 'success' }] },
      { icon: 'fa-fire', iconColor: 'danger', meta: 'mistral', cells: ['Mistral', 'Mistral AI', '14', '0.9M', '$80', { text: 'Healthy', badge: 'success' }] }
    ]
  })

  //- Agentic workflows and evaluations: the two things that separate agent monitoring
  //- from plain LLM call logging. A single call either worked or did not; a workflow
  //- can complete with a step that quietly failed, and an answer can be well-formed and
  //- still wrong — which is what the eval scores are for.
  .row.g-4.mt-0
    .col-12.col-xl-7
      +ObsToolTable({
        live: 'agentWorkflows',
        title: 'Agentic workflows',
        subtitle: 'Multi-step runs reconstructed from trace parentage, newest first',
        searchPlaceholder: 'Search workflows',
        pageSize: 6,
        columns: [
          { label: 'Workflow', className: 'ps-3' },
          { label: 'Agents' },
          { label: 'Steps' },
          { label: 'Duration' },
          { label: 'Started' },
          { label: 'Status' }
        ],
        rows: [
          { icon: 'fa-code-branch', iconColor: 'success', meta: 'wf-9f2a41c8', cells: ['nightly-triage', '3', '12 / 12', '48.2s', '14:02 UTC', { text: 'Completed', badge: 'success' }] },
          { icon: 'fa-code-branch', iconColor: 'danger', meta: 'wf-1b77de03', cells: ['incident-summariser', '2', '5 / 7', '19.4s', '13:58 UTC', { text: 'Failed', badge: 'danger' }] },
          { icon: 'fa-code-branch', iconColor: 'success', meta: 'wf-4c0e9a15', cells: ['pr-reviewer', '4', '21 / 21', '2m 11s', '13:44 UTC', { text: 'Completed', badge: 'success' }] },
          { icon: 'fa-code-branch', iconColor: 'success', meta: 'wf-77ba2e60', cells: ['runbook-drafter', '2', '8 / 8', '31.7s', '13:30 UTC', { text: 'Completed', badge: 'success' }] },
          { icon: 'fa-code-branch', iconColor: 'danger', meta: 'wf-2ed4b099', cells: ['schema-migrator', '3', '4 / 9', '1m 02s', '13:12 UTC', { text: 'Failed', badge: 'danger' }] },
          { icon: 'fa-code-branch', iconColor: 'success', meta: 'wf-8a31cc27', cells: ['cost-explainer', '1', '6 / 6', '12.9s', '12:55 UTC', { text: 'Completed', badge: 'success' }] }
        ]
      })

    .col-12.col-xl-5
      +ObsToolTable({
        live: 'agentEvaluations',
        title: 'Observations & evaluations',
        subtitle: 'Scored annotations on stored spans, rolled up per metric',
        searchPlaceholder: 'Search metrics',
        pageSize: 6,
        columns: [
          { label: 'Metric', className: 'ps-3' },
          { label: 'Annotations' },
          { label: 'Avg score' },
          { label: 'Pass rate' },
          { label: 'Spans' },
          { label: 'Status' }
        ],
        rows: [
          { icon: 'fa-flask', iconColor: 'success', meta: '412 annotations', cells: ['faithfulness', '412', '0.918', '96.4%', '388', { text: 'Passing', badge: 'success' }] },
          { icon: 'fa-flask', iconColor: 'warning', meta: '406 annotations', cells: ['relevance', '406', '0.874', '89.1%', '388', { text: 'Below target', badge: 'warning' }] },
          { icon: 'fa-flask', iconColor: 'success', meta: '388 annotations', cells: ['toxicity', '388', '0.996', '99.7%', '388', { text: 'Passing', badge: 'success' }] },
          { icon: 'fa-flask', iconColor: 'success', meta: '201 annotations', cells: ['tool-choice', '201', '0.931', '94.5%', '196', { text: 'Passing', badge: 'success' }] },
          { icon: 'fa-flask', iconColor: 'secondary', meta: 'human review', cells: ['helpfulness', '64', 'not scored', '—', '64', { text: 'Unscored', badge: 'secondary' }] }
        ]
      })
