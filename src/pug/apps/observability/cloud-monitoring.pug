extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Cloud Monitoring', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Cloud Monitoring',
    subtitle: 'Every AWS account your connected credential reaches, with what it owns, what is alarming, and what it has cost this month',
    action: 'Refresh',
    actionKey: 'refreshData'
  })

  +ObsStatCards([
    { key: 'linkedAccounts', label: 'Linked accounts', value: '18', delta: '3 clouds', badge: 'info' },
    { key: 'resources', label: 'Resources watched', value: '12.4k', delta: '+320', badge: 'success' },
    { key: 'openAlarms', label: 'Open cloud alarms', value: '7', delta: '2 critical', badge: 'danger' },
    { key: 'mtdSpend', label: 'Spend month to date', value: 'USD 42,180.00', delta: 'since 2026-09-01', badge: 'primary' }
  ])

  .card.mb-4
    .card-header.border-bottom.border-translucent.py-3
      .row.align-items-center
        .col
          h4.mb-0 Configure cloud accounts
          p.text-body-tertiary.fs-9.mb-0 Accounts are connected under Integrations → Cloud accounts; every one of them is monitored here.
        .col-auto
          a.btn.btn-sm.btn-primary(href=`${CWD}${paths['int-cloud']}`) Connect an account
    .card-body
      .row.g-3
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 AWS
            p.text-body-tertiary.fs-9.mb-2 Cross-account IAM role or Organizations linkage. Monitor every member account under the org OU.
            ul.fs-9.mb-0
              li CloudWatch metrics & alarms
              li GuardDuty / Config findings
              li Multi-account inventory
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 Google Cloud
            p.text-body-tertiary.fs-9.mb-2 Service account or folder-level access across projects in the org.
            ul.fs-9.mb-0
              li Cloud Monitoring metrics
              li Logging / Error Reporting
              li Project & folder hierarchy
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 Microsoft Azure
            p.text-body-tertiary.fs-9.mb-2 App registration / management group scope for subscriptions.
            ul.fs-9.mb-0
              li Azure Monitor metrics
              li Activity Log alerts
              li Subscription rollups

  +ObsToolTable({
    title: 'Linked accounts',
    live: 'cloudAccounts',
    subtitle: 'From organizations:ListAccounts on the connected credential — nothing is registered here',
    searchPlaceholder: 'Search accounts',
    pageSize: 8,
    columns: [
      { label: 'Account', className: 'ps-3' },
      { label: 'Cloud' },
      { label: 'Type' },
      { label: 'Resources' },
      { label: 'Open alarms' },
      { label: 'Cost (MTD)' },
      { label: 'Status' }
    ],
    rows: [
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'success', meta: '111122223333', cells: ['prod-root', 'AWS', 'Connected account', '482', '0', 'USD 18,220.14', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: '444455556666', cells: ['prod-workloads', 'AWS', 'Member account', '214', '2', 'USD 15,904.77', { text: 'Alarm', badge: 'warning' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'success', meta: '777788889999', cells: ['dev-sandbox', 'AWS', 'Member account', '68', '0', 'USD 1,142.03', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'danger', meta: 'ClientError: not authorized to perform sts:AssumeRole', cells: ['data-platform', 'AWS', 'Member account', '—', '—', 'USD 6,913.44', { text: 'Unreachable', badge: 'danger' }] }
    ]
  })

  +ObsToolTable({
    title: 'Streamed services',
    live: 'cloudServices',
    subtitle: 'Every AWS service your CloudWatch metric stream is delivering — no per-service integration behind any of these',
    searchPlaceholder: 'Search services',
    pageSize: 8,
    action: 'Set up metric streaming',
    actionKey: 'cloudSetup',
    columns: [
      { label: 'Service', className: 'ps-3' },
      { label: 'Account' },
      { label: 'Regions' },
      { label: 'Resources' },
      { label: 'Metrics' },
      { label: 'Last seen' },
      { label: 'Freshness' }
    ],
    rows: [
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: 'AWS/EC2', cells: ['EC2', '111122223333', 'us-east-1', '42', '18', '2026-09-10T10:04:00Z', { text: 'Live', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: 'AWS/RDS', cells: ['RDS', '111122223333', 'us-east-1, eu-west-1', '6', '24', '2026-09-10T10:04:00Z', { text: 'Live', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: 'AWS/SQS', cells: ['SQS', '444455556666', 'us-east-1', '11', '9', '2026-09-10T09:12:00Z', { text: 'Lagging', badge: 'warning' }] }
    ]
  })

  .row.g-4.mb-4
    .col-12
      +ObsToolTable({
        title: 'Metric alert conditions',
        live: 'metricConditions',
        subtitle: 'Evaluated as each delivery lands, so a breach is about a minute old — not a poll interval old',
        searchPlaceholder: 'Search conditions',
        pageSize: 5,
        rowAction: true,
        action: 'Add condition',
        actionKey: 'addMetricCondition',
        columns: [
          { label: 'Condition', className: 'ps-3' },
          { label: 'Metric' },
          { label: 'For' },
          { label: 'Watching' },
          { label: 'Firing' },
          { label: 'Status' }
        ],
        rows: [
          { icon: 'fa-bell', iconColor: 'danger', meta: 'AWS/EC2 · avg > 80', cells: ['EC2 CPU above 80%', 'CPUUtilization', '2m', '42', '3', { text: 'Firing', badge: 'danger' }] },
          { icon: 'fa-bell-slash', iconColor: 'success', meta: 'AWS/SQS · max > 1000', cells: ['Order queue backing up', 'ApproximateNumberOfMessagesVisible', '3m', '11', '0', { text: 'OK', badge: 'success' }] }
        ]
      })

  +ObsToolTable({
    title: 'Resource changes',
    live: 'cloudChanges',
    subtitle: 'What appeared, vanished or changed between inventory snapshots',
    searchPlaceholder: 'Search changes',
    pageSize: 5,
    action: 'Scan for changes',
    actionKey: 'scanCloudChanges',
    columns: [
      { label: 'Resource', className: 'ps-3' },
      { label: 'Kind' },
      { label: 'Account' },
      { label: 'Seen' },
      { label: 'Change' }
    ],
    rows: [
      { icon: 'fa-plus', iconColor: 'success', meta: '111122223333', cells: ['assets-staging', 'S3 bucket', 'prod-root', '2026-09-10T08:00:00Z', { text: 'Added', badge: 'success' }] },
      { icon: 'fa-trash', iconColor: 'danger', meta: '444455556666', cells: ['legacy-exports', 'S3 bucket', 'prod-workloads', '2026-09-09T18:20:00Z', { text: 'Removed', badge: 'danger' }] }
    ]
  })
