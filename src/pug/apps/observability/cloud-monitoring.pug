extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Cloud Monitoring', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Cloud Monitoring',
    subtitle: 'Every AWS account your connected credential reaches, with what it owns, what is alarming, and what it has cost this month',
    action: 'Refresh',
    actionKey: 'refreshData'
  })

  +ObsStatCards([
    { key: 'linkedAccounts', label: 'Linked accounts', value: '18', delta: '3 clouds', badge: 'info' },
    { key: 'resources', label: 'Resources watched', value: '12.4k', delta: '+320', badge: 'success' },
    { key: 'openAlarms', label: 'Open cloud alarms', value: '7', delta: '2 critical', badge: 'danger' },
    { key: 'mtdSpend', label: 'Spend month to date', value: 'USD 42,180.00', delta: 'since 2026-09-01', badge: 'primary' }
  ])

  .card.mb-4
    .card-header.border-bottom.border-translucent.py-3
      .row.align-items-center
        .col
          h4.mb-0 Configure cloud accounts
          p.text-body-tertiary.fs-9.mb-0 Accounts are connected under Integrations → Cloud accounts; every one of them is monitored here.
        .col-auto
          a.btn.btn-sm.btn-primary(href=`${CWD}${paths['int-cloud']}`) Connect an account
    .card-body
      .row.g-3
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 AWS
            p.text-body-tertiary.fs-9.mb-2 Cross-account IAM role or Organizations linkage. Monitor every member account under the org OU.
            ul.fs-9.mb-0
              li CloudWatch metrics & alarms
              li GuardDuty / Config findings
              li Multi-account inventory
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 Google Cloud
            p.text-body-tertiary.fs-9.mb-2 Service account or folder-level access across projects in the org.
            ul.fs-9.mb-0
              li Cloud Monitoring metrics
              li Logging / Error Reporting
              li Project & folder hierarchy
        .col-md-4
          .border.border-translucent.rounded-3.p-3.h-100
            h6.mb-2 Microsoft Azure
            p.text-body-tertiary.fs-9.mb-2 App registration / management group scope for subscriptions.
            ul.fs-9.mb-0
              li Azure Monitor metrics
              li Activity Log alerts
              li Subscription rollups

  +ObsToolTable({
    title: 'Linked accounts',
    live: 'cloudAccounts',
    subtitle: 'From organizations:ListAccounts on the connected credential — nothing is registered here',
    searchPlaceholder: 'Search accounts',
    pageSize: 8,
    columns: [
      { label: 'Account', className: 'ps-3' },
      { label: 'Cloud' },
      { label: 'Type' },
      { label: 'Resources' },
      { label: 'Open alarms' },
      { label: 'Cost (MTD)' },
      { label: 'Status' }
    ],
    rows: [
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'success', meta: '111122223333', cells: ['prod-root', 'AWS', 'Connected account', '482', '0', 'USD 18,220.14', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: '444455556666', cells: ['prod-workloads', 'AWS', 'Member account', '214', '2', 'USD 15,904.77', { text: 'Alarm', badge: 'warning' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'success', meta: '777788889999', cells: ['dev-sandbox', 'AWS', 'Member account', '68', '0', 'USD 1,142.03', { text: 'Healthy', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'danger', meta: 'ClientError: not authorized to perform sts:AssumeRole', cells: ['data-platform', 'AWS', 'Member account', '—', '—', 'USD 6,913.44', { text: 'Unreachable', badge: 'danger' }] }
    ]
  })
