extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Observability', href: '#!' },
      { label: 'Logs', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Logs',
    subtitle: 'Search across every service, gateway, and pipeline — indexed per organization in Elasticsearch',
    action: 'Save search',
    actionKey: 'saveSearch'
  })

  +ObsStatCards([
    { label: 'Ingested (24h)', value: '918M', delta: '+4.2%', badge: 'info' },
    { label: 'Error lines', value: '1.4M', delta: '+18%', badge: 'warning' },
    { label: 'Indices', value: '31', delta: '7d hot · 30d warm', badge: 'primary' },
    { label: 'Index lag', value: '2.1s', delta: '-0.4s', badge: 'success' }
  ])

  .card.mb-4
    .card-body
      .row.g-2.align-items-end
        .col-12.col-lg-5
          label.form-label.fs-9(for='log-query') Query
          input.form-control.form-control-sm.font-monospace#log-query(type='search' value='level:error AND service:checkout-api' aria-label='Log search query')
        .col-6.col-lg-2
          label.form-label.fs-9(for='log-service') Service
          select.form-select.form-select-sm#log-service(aria-label='Filter by service')
            option(value='') All services
            option(value='checkout-api' selected) checkout-api
            option(value='payments-api') payments-api
            option(value='identity-api') identity-api
            option(value='etl-nightly') etl-nightly
        .col-6.col-lg-2
          label.form-label.fs-9(for='log-level') Level
          select.form-select.form-select-sm#log-level(aria-label='Filter by level')
            option(value='') All levels
            option(value='error' selected) error
            option(value='warn') warn
            option(value='info') info
            option(value='debug') debug
        .col-6.col-lg-2
          label.form-label.fs-9(for='log-range') Range
          select.form-select.form-select-sm#log-range(aria-label='Time range')
            option(value='15m') Last 15 minutes
            option(value='1h' selected) Last hour
            option(value='24h') Last 24 hours
            option(value='7d') Last 7 days
        .col-6.col-lg-1
          button.btn.btn-primary.btn-sm.w-100(type='button' data-lhb-action='refreshData') Search

  //- live='logs' replaces these rows with a real Elasticsearch search; the sample lines
  //- below stay as the fallback when nothing is indexed or the user is signed out.
  .card(data-live-table='logs')
    .card-header.border-bottom.border-translucent.py-3
      h4.mb-0 Matching lines
      p.text-body-tertiary.fs-9.mb-0 1,482 hits · newest first
    .card-body.p-0
      .table-responsive.scrollbar
        table.table.table-sm.fs-10.mb-0
          thead
            tr
              th.ps-3.text-uppercase Timestamp
              th.text-uppercase Level
              th.text-uppercase Service
              th.text-uppercase Message
          tbody(data-sample-rows)
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:03:44.812
              td
                span.badge.badge-phoenix.badge-phoenix-danger error
              td checkout-api
              td.font-monospace timeout waiting for connection from pool "orders" after 3000ms
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:03:44.109
              td
                span.badge.badge-phoenix.badge-phoenix-danger error
              td checkout-api
              td.font-monospace query cancelled: statement_timeout exceeded (SELECT … FROM order_items)
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:03:41.556
              td
                span.badge.badge-phoenix.badge-phoenix-warning warn
              td checkout-api
              td.font-monospace replica lag 14.8s above threshold 5s, routing reads to primary
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:03:40.201
              td
                span.badge.badge-phoenix.badge-phoenix-danger error
              td api-gateway
              td.font-monospace upstream returned 504 for POST /v1/orders (checkout-api)
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:02:10.004
              td
                span.badge.badge-phoenix.badge-phoenix-warning warn
              td orders-db
              td.font-monospace seconds_behind_master=14 (backfill nightly-customer-load in progress)
            tr
              td.ps-3.font-monospace.white-space-nowrap 14:01:58.774
              td
                span.badge.badge-phoenix.badge-phoenix-info info
              td etl-nightly
              td.font-monospace talend task nightly-customer-load started, 4.2M rows queued
    .card-footer.border-top.border-translucent
      p.fs-9.text-body-tertiary.mb-0 Retention follows the organization's plan — hot 7 days, warm 30 days, then expired by index lifecycle policy.
