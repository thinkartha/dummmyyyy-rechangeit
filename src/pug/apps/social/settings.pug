extends ../../layouts/LayoutTheme

append variables
  -
    var breadcrumb = [
      { label: 'Account', href: '#!' },
      { label: 'Profile', href: '#!', active: true }
    ];

block content
  //- The theme's settings screen was a social-network profile: follower counts, profile
  //- visibility radios, "who can tag you", company info, six social handles. None of it
  //- had anywhere to save to. What is left is what this product actually knows about an
  //- account — who you are, which organization you are in, and your password.
  .mb-9
    .row.g-4
      .col-12.col-xl-4
        .card.h-100
          .card-body.text-center
            //- Same file the navbar's avatar uses, so the face in the corner and the
            //- face on this page are one person.
            img.rounded-circle.img-thumbnail.shadow-sm.border-0.mb-3(
              src=`${CWD}assets/img/team/72x72/57.webp` width=112 height=112 alt='')
            h3.mb-1(data-lhb-account='name') —
            p.text-body-tertiary.fs-9.mb-3(data-lhb-account='email')
            .d-flex.justify-content-center.gap-4.fs-9
              div
                span.fa-solid.fa-building.text-body-tertiary.me-2
                span(data-lhb-account='orgName') —
              div
                span.fa-solid.fa-user-shield.text-body-tertiary.me-2
                span(data-lhb-account='role') —

      .col-12.col-xl-8
        .card.mb-4
          .card-body
            h4.mb-3 Personal details
            .row.g-3.fs-9
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Name
                p.mb-0.fw-semibold(data-lhb-account='name') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Email
                p.mb-0.fw-semibold(data-lhb-account='email') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Role
                p.mb-0.fw-semibold(data-lhb-account='role') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Signed in as
                p.mb-0.fw-semibold.font-monospace.fs-10(data-lhb-account='email') —
            //- Read-only: these come from the identity provider, and there is no endpoint
            //- that rewrites them. A form that silently discards edits is worse than text.
            p.text-body-tertiary.fs-10.mt-3.mb-0 Name and email come from your sign-in account.

        .card.mb-4
          .card-body
            h4.mb-3 Organization
            .row.g-3.fs-9
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Organization
                p.mb-0.fw-semibold(data-lhb-account='orgName') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Owner
                p.mb-0.fw-semibold(data-lhb-account='orgOwner') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Plan
                p.mb-0.fw-semibold(data-lhb-account='orgPlan') —
              .col-12.col-sm-6
                p.text-body-tertiary.fs-10.text-uppercase.mb-1 Your role
                p.mb-0.fw-semibold(data-lhb-account='role') —

            //- Owner-only. Hidden until account.js confirms the signed-in address is the
            //- organization's owner_email — the two things only the person who created
            //- the organization should be able to do.
            .border-top.border-translucent.mt-4.pt-4(data-lhb-owner-only hidden)
              .row.gy-4
                .col-12.col-md-6
                  h5.text-body-emphasis.mb-1 Invite people
                  p.text-body-tertiary.fs-9 Send someone an invite and choose what they can do once they accept.
                  button.btn.btn-phoenix-primary.btn-sm(type='button' data-lhb-action='inviteMember') Invite a member
                .col-12.col-md-6
                  h5.text-body-emphasis.mb-1 Transfer ownership
                  p.text-body-tertiary.fs-9 Hand the organization to another member. They become an admin and the owner; you keep your admin access.
                  button.btn.btn-phoenix-warning.btn-sm(type='button' data-lhb-action='transferOwnership') Transfer ownership

        .card
          .card-body
            h4.mb-2 Password
            p.text-body-tertiary.fs-9 Rotate it with the current one. Forgotten it instead? Sign out and use "Forgot password" to get a code by email.
            button.btn.btn-phoenix-secondary.btn-sm(type='button' data-lhb-action='changePassword') Change password
