extends ../../layouts/LayoutTheme
include ../../mixins/social/Feed
include ../../mixins/social/Settings


append variables

block content
  .mb-9
    .row.g-6
      .col-12.col-xl-4
        +SettingsProfileCard.mb-5
        +LeftSidebar
      .col-12.col-xl-8
        .border-bottom.mb-4
          +PersonalInformation
          .row.gx-3.mb-6.gy-6.gy-sm-3
            .col-12.col-sm-6
              +CompanyInfo
            .col-12.col-sm-6
              +ChangePassword
          .mb-6
            +Social
          .text-end.mb-6
            div
              button.btn.btn-phoenix-secondary.me-2 Cancel Changes
              button.btn.btn-phoenix-primary Save Information
        //- Owner-only. `data-lhb-owner-only` is hidden until account.js confirms the
        //- signed-in user is the owner_email on their organization — the two things
        //- only the person who created the organization should be able to do.
        .row.gy-5(data-lhb-owner-only hidden)
          .col-12.col-md-6
            h4.text-body-emphasis Invite people
            p.text-body-tertiary Send someone an invite to
              span.fw-semibold.ms-1(data-lhb-account='orgName') your organization
              |  and choose what they can do once they accept.
            button.btn.btn-phoenix-primary(type='button' data-lhb-action='inviteMember') Invite a member
          .col-12.col-md-6
            h4.text-body-emphasis Transfer ownership
            p.text-body-tertiary Hand the organization to another member. They become an admin and the owner; you keep your admin access.
            button.btn.btn-phoenix-warning(type='button' data-lhb-action='transferOwnership') Transfer ownership
  