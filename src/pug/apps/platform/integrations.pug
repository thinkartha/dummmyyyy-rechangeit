extends ../../layouts/LayoutTheme
include ../../mixins/dashboard/common
include ../../mixins/observability/Common

append variables
  -
    var breadcrumb = [
      { label: 'Platform', href: '#!' },
      { label: 'Integrations', href: '#!', active: true }
    ];

block content
  +ObsPageHeader({
    title: 'Integrations & Config Management',
    subtitle: 'Every source this organization has connected, what it is feeding, and whether its credentials still work',
    action: 'Add integration',
    actionKey: 'addIntegration'
  })

  +ObsStatCards([
    { label: 'Connected', value: '27', delta: '+4', badge: 'success' },
    { label: 'Needs attention', value: '3', delta: 'auth or quota', badge: 'warning' },
    { label: 'Credentials expiring', value: '2', delta: 'within 30d', badge: 'danger' },
    { label: 'Available', value: '41', delta: 'in catalog', badge: 'info' }
  ])

  .alert.alert-subtle-warning.d-flex.align-items-center.mb-4(role='alert')
    span.fa-solid.fa-triangle-exclamation.me-2
    div
      strong Two credentials expire within 30 days.
      span.ms-1 Rotate the Databricks PAT and the Okta client secret before they lapse — collection stops silently when they do.

  +ObsToolTable({
    title: 'Connected integrations',
    live: 'integrations',
    rowAction: true,
    subtitle: 'Credentials are stored as secret references under org_id and never returned to the browser',
    searchPlaceholder: 'Search integrations',
    pageSize: 10,
    columns: [
      { label: 'Integration', className: 'ps-3' },
      { label: 'Category' },
      { label: 'Feeds' },
      { label: 'Last sync' },
      { label: 'Credential' },
      { label: 'Status' }
    ],
    rows: [
      { iconSet: 'fa-brands', icon: 'fa-aws', iconColor: 'warning', meta: '4 accounts', cells: ['AWS CloudWatch', 'Cloud', 'Cloud Monitoring, Cost', '2m ago', 'IAM role', { text: 'Connected', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-microsoft', iconColor: 'info', meta: '2 subscriptions', cells: ['Azure Monitor', 'Cloud', 'Cloud Monitoring, Cost', '4m ago', 'Service principal', { text: 'Connected', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-google', iconColor: 'danger', meta: '3 projects', cells: ['Google Cloud Operations', 'Cloud', 'Cloud Monitoring, Cost', '6m ago', 'Service account', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-cloud', iconColor: 'warning', meta: 'api-prod-us-east-1', cells: ['AWS API Gateway', 'Gateway', 'API Gateway, Traces', '1m ago', 'IAM role', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-satellite-dish', iconColor: 'primary', meta: 'OTLP collector', cells: ['OpenTelemetry', 'Telemetry', 'Traces, Logs, Metrics', 'streaming', 'Ingest key', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-diagram-project', iconColor: 'primary', meta: 'cloud + studio', cells: ['Talend', 'ETL', 'ETL Monitoring', '12m ago', 'OAuth client', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-plug', iconColor: 'info', meta: 'atom spheres', cells: ['Dell Boomi', 'ETL', 'ETL Monitoring', '28m ago', 'Basic auth', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-database', iconColor: 'danger', meta: 'unity catalog', cells: ['Databricks', 'Data', 'Data Observability, ETL', '9m ago', 'PAT · 12d left', { text: 'Expiring', badge: 'warning' }] },
      { icon: 'fa-wind', iconColor: 'success', meta: 'MWAA us-east-1', cells: ['Apache Airflow', 'Orchestration', 'Orchestration Monitoring', '2m ago', 'API token', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-shield-halved', iconColor: 'primary', meta: 'rootvyana.okta.com', cells: ['Okta', 'Identity', 'SSO, Members', '1h ago', 'Client secret · 21d left', { text: 'Expiring', badge: 'warning' }] },
      { icon: 'fa-bell', iconColor: 'success', meta: 'payments-oncall', cells: ['PagerDuty', 'Notification', 'Alert routing', '5m ago', 'Integration key', { text: 'Connected', badge: 'success' }] },
      { iconSet: 'fa-brands', icon: 'fa-slack', iconColor: 'success', meta: '6 channels', cells: ['Slack', 'Notification', 'Alert routing', '3m ago', 'Bot token', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-ticket', iconColor: 'info', meta: 'L2 queue', cells: ['ServiceNow', 'Notification', 'Alert routing, Incidents', '22m ago', 'OAuth client', { text: 'Connected', badge: 'success' }] },
      { icon: 'fa-chart-line', iconColor: 'secondary', meta: 'controller', cells: ['AppDynamics', 'APM', 'API Monitoring', '3h ago', 'API client', { text: 'Auth failed', badge: 'danger' }] },
      { icon: 'fa-layer-group', iconColor: 'warning', meta: 'alert correlation', cells: ['BigPanda', 'Alerting', 'Correlation', '—', 'API key', { text: 'Not connected', badge: 'secondary' }] }
    ]
  })

  //- Every setting that used to live only on the page it belonged to. The buttons are
  //- the same actions those pages fire — one registry entry, two places to reach it —
  //- so this catalogue cannot drift away from what the pages actually do.
  .card.mt-4
    .card-header.border-bottom.border-translucent.py-3
      h4.mb-0 Settings & configuration
      p.text-body-tertiary.fs-9.mb-0 Everything configurable across the product, reachable without hunting for the page that owns it
    .card-body
      each group in [{ name: 'Gateways', items: [{ label: 'Connect an API gateway', help: 'Kong, APISIX, Tyk, Traefik, KrakenD, AWS API Gateway, Azure APIM, Apigee.', action: 'connectGateway', page: 'API Gateway' }, { label: 'Install our gateway', help: 'Run APISIX in front of your API and report from it.', action: 'onboardGateway', page: 'API Gateway' }] }, { name: 'Cloud', items: [{ label: 'Connect AWS account', help: 'Region, credentials, function prefixes and alert thresholds. Feeds Cloud Monitoring and Orchestration.', action: 'connectAwsAccount', page: 'Cloud Monitoring' }] }, { name: 'Data & ETL', items: [{ label: 'Connect an ETL tool', help: 'Talend, Boomi or Databricks.', action: 'connectEtl', page: 'ETL Monitoring' }, { label: 'Connect Databricks', help: 'Workspace host, SQL warehouse and token — also backs Data Observability.', action: 'connectDatabricks', page: 'Data Observability' }, { label: 'Register a database', help: 'Connection string, tested before it is saved.', action: 'addDatabase', page: 'Database Monitoring' }] }, { name: 'AI', items: [{ label: 'Connect an AI tool', help: 'Registers the collector agent that pushes AI telemetry and mints its key.', action: 'connectAiTool', page: 'AI Monitoring' }, { label: 'Register a model', help: 'Track a custom or hosted model alongside the providers.', action: 'registerModel', page: 'AI Models' }, { label: 'Model thresholds', help: 'Error-rate and latency limits every model status badge is derived from.', action: 'editThresholds', page: 'AI Models' }, { label: 'AI budget', help: 'Monthly spend ceiling and who to warn as it is approached.', action: 'setAiBudget', page: 'AI Cost & Usage' }] }, { name: 'Cost', items: [{ label: 'Cloud budget', help: 'Per-account budget and alert threshold.', action: 'addBudget', page: 'Cloud Cost' }] }, { name: 'Alerting', items: [{ label: 'Routing rule', help: 'Which team a matching alert pages, on which channels, and when it escalates.', action: 'routingRule', page: 'Alert Management' }, { label: 'Automation rule', help: 'Trigger and action for a remediation the platform runs itself.', action: 'automationRule', page: 'Automation' }] }]
        h6.mt-3.mb-2.text-uppercase.fs-10.text-body-tertiary= group.name
        .row.g-3
          each item in group.items
            .col-12.col-md-6.col-xl-4
              .border.border-translucent.rounded-3.p-3.h-100.d-flex.flex-column
                h6.mb-1= item.label
                p.text-body-tertiary.fs-9.mb-2= item.help
                .mt-auto.d-flex.align-items-center.justify-content-between
                  span.badge.badge-phoenix.badge-phoenix-secondary.fs-10= item.page
                  button.btn.btn-phoenix-primary.btn-sm(type='button' data-lhb-action=item.action) Configure
