extends ../../../layouts/LayoutTheme
include ../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37})
    .auth-form-box(data-lhb-auth='reset' data-lhb-signin=`${CWD}${paths['card-signin']}` data-lhb-confirm=`${CWD}${paths['card-2FA']}` data-lhb-reset=`${CWD}${paths['card-reset-password']}`)
      .text-center.mb-7
        a(href=`${CWD}${paths['default-dashboard']}`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h4.text-body-highlight Reset new password
        p.text-body-tertiary Type your new password
      form.mt-5
        //- /auth/reset-password takes all three: the code proves the email is yours.
        .text-start.mb-3
          label.form-label(for='reset-email') Email address
          input#reset-email.form-control(type='text' placeholder='name@example.com' name='email')
        .text-start.mb-3
          label.form-label(for='reset-code') Reset code
          input#reset-code.form-control(type='text' placeholder='6-digit code' inputmode='numeric' name='code')
        .position-relative.mb-2(data-password)
          input#password.form-control.form-icon-input.pe-6(type='password' placeholder='Type new password' data-password-input name='new_password')
          button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(data-password-toggle)
            span.uil.uil-eye.show
            span.uil.uil-eye-slash.hide
        .position-relative.mb-4(data-password)
          input#confirmPassword.form-control.form-icon-input.pe-6(type='password' placeholder='Cofirm new password' data-password-input name='confirmPassword')
          button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(data-password-toggle)
            span.uil.uil-eye.show
            span.uil.uil-eye-slash.hide
        button.btn.btn-primary.w-100(type='button' data-lhb-auth-submit) Set Password
