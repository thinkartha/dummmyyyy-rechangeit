extends ../../../layouts/LayoutTheme
include ../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37, page: 'forgot-pasword'})
    .auth-form-box(data-lhb-auth='forgot' data-lhb-signin=`${CWD}${paths['card-signin']}` data-lhb-confirm=`${CWD}${paths['card-2FA']}` data-lhb-reset=`${CWD}${paths['card-reset-password']}`)
      .text-center
        a(href=`${CWD}${paths['default-dashboard']}`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h4.text-body-highlight Forgot your password?
        p.text-body-tertiary.mb-5 Enter your email below and we will 
          br.d-md-none
          | send you 
          br.d-none.d-xxl-block
          | a reset link
        form.d-flex.align-items-center.mb-5&attributes(attributes)
          input#email.form-control.flex-1(type='email' placeholder='Email' name='email')
          button.btn.btn-primary.ms-2(type='button' data-lhb-auth-submit)
            | Send
            span.fas.fa-chevron-right.ms-2
        a.fs-9.fw-bold(href="#!") Still having problems?
