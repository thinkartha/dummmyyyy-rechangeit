extends ../../layouts/LayoutTheme
include ../../mixins/common/Logo
include ../../mixins/authentication/ProductAuth

append variables
  - var disableNavigationType = true;
  - var disableVerticalNavbarAppearance = true;
  - var disableHorizontalNavbarShape = true;
  - var disableHorizontalNavbarAppearance = true;
  - var hideSettingPanel = true;

block mainContent
  +ProductAuthShell({
    title: 'Set a new password',
    subtitle: 'Enter the code we sent you along with your new password.'
  })(data-lhb-auth='reset')
    +ProductAuthField({
      id: 'email', name: 'email', label: 'Email', icon: 'fa-envelope',
      placeholder: 'you@company.com', autocomplete: 'email'
    })
    +ProductAuthField({
      id: 'code', name: 'code', label: 'Reset code', icon: 'fa-key',
      placeholder: 'Enter 6-digit code', maxlength: 10, inputClass: 'font-monospace'
    })
    +ProductAuthField({
      id: 'new_password', name: 'new_password', label: 'New password', icon: 'fa-lock',
      type: 'password', placeholder: 'At least 8 characters',
      autocomplete: 'new-password', reveal: true, inputClass: 'pe-6'
    })
    +ProductAuthField({
      id: 'confirmPassword', name: 'confirmPassword', label: 'Confirm password', icon: 'fa-lock',
      type: 'password', placeholder: 'Repeat your new password',
      autocomplete: 'new-password', reveal: true, inputClass: 'pe-6'
    })

    button.btn.btn-primary.w-100(type='button' data-lhb-auth-submit) Set password

    p.text-center.fs-9.text-body-tertiary.mt-4.mb-0
      a(href=`${CWD}${paths['product-signin']}`) Back to sign in
