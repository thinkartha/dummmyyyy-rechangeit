extends ../../layouts/LayoutTheme
include ../../mixins/common/Logo
include ../../mixins/authentication/ProductAuth

append variables
  - var disableNavigationType = true;
  - var disableVerticalNavbarAppearance = true;
  - var disableHorizontalNavbarShape = true;
  - var disableHorizontalNavbarAppearance = true;
  - var hideSettingPanel = true;

block mainContent
  +ProductAuthShell({
    title: 'Forgot your password?',
    subtitle: 'Enter your email and we will send you a code to reset it.'
  })(data-lhb-auth='forgot')
    +ProductAuthField({
      id: 'email', name: 'email', label: 'Email', icon: 'fa-envelope',
      placeholder: 'you@company.com', autocomplete: 'email'
    })

    button.btn.btn-primary.w-100(type='button' data-lhb-auth-submit) Send reset code

    //- The API answers identically for an address it does not know, so this form cannot
    //- be used to find out who has an account here.
    p.text-center.fs-10.text-body-tertiary.mt-4.mb-0
      | If the address has an account, a code is on its way.
    p.text-center.fs-9.mt-2.mb-0
      a(href=`${CWD}${paths['product-signin']}`) Back to sign in
